{
  "name": "ozon-sjsq",
  "version": "0.3.36",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "node --max-old-space-size=768 ./node_modules/typescript/bin/tsc && node --max-old-space-size=768 ./node_modules/vite/bin/vite.js build",
    "build:web": "node --max-old-space-size=768 ./node_modules/typescript/bin/tsc && node --max-old-space-size=768 ./node_modules/vite/bin/vite.js build --config vite.web.config.ts && node scripts/normalize-web-build.mjs",
    "tauri:build": "tauri build",
    "tauri:build:mac": "tauri build --bundles dmg",
    "tauri:build:windows": "tauri build --bundles nsis",
    "updater:manifest": "node scripts/generate-updater-manifest.mjs",
    "test": "node --max-old-space-size=4096 ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
