# ============================================================
# 本地测试环境配置 (.env.local)
# ============================================================
# 用法: cp server/.env.local.example server/.env.local
#       然后修改 DATABASE_URL 等必要配置
#       最后运行: cd server && npm run db:setup
#
# 与生产 .env 的区别:
#   - 数据库指向本地 PostgreSQL (不能和生产共用)
#   - 存储建议用 STORAGE_PROVIDER=local (避免消耗 R2 流量)
#   - JWT_SECRET 和 ADMIN_TOKEN 可以用测试值
# ============================================================

NODE_ENV=development
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787

# 本地测试用密钥 (不要和生产共用)
JWT_SECRET=local-dev-jwt-secret-change-me-24chars
ADMIN_TOKEN=local-dev-admin-token

# 超级管理员手机号（测试环境，不影响生产）
SUPER_ADMIN_PHONE=18338062216

# ── 本地 PostgreSQL ──
# 如果使用 Docker: docker-compose up -d (在 server 目录)
# 端口: 5432, 用户: ozon_sjsq, 密码: ozon_sjsq_dev, 库名: ozon_sjsq_cloud
DATABASE_URL=postgresql://ozon_sjsq:ozon_sjsq_dev@127.0.0.1:5432/ozon_sjsq_cloud

# ── 本地文件存储 (推荐，省 R2 流量) ──
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# ── 存储（如需使用 R2 进行端到端测试） ──
# STORAGE_PROVIDER=r2
# STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
# STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# STORAGE_BUCKET=ozon-sjsq-gallery
# STORAGE_PUBLIC_BASE_URL=https://img.example.com

# ── 上传限制 ──
MAX_UPLOAD_MB=15

# ── 可选: 如果本地 PostgreSQL 端口冲突 ──
# DB_POOL_MAX=5
