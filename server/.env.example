NODE_ENV=development
PORT=8787
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
CORS_ORIGINS=http://127.0.0.1:8787
ADMIN_IP_ALLOWLIST=

# Replace these in production. Do not commit real secrets.
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_TOKEN=change-me-admin-token

# PostgreSQL, for example:
# postgresql://ozon_sjsq:your_password@127.0.0.1:5432/ozon_sjsq_cloud
DATABASE_URL=postgresql://ozon_sjsq:ozon_sjsq_dev@127.0.0.1:5432/ozon_sjsq_cloud
DB_POOL_MAX=20

# Cloudflare R2 / Backblaze B2 or another S3-compatible storage.
STORAGE_PROVIDER=r2
STORAGE_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=replace-with-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
STORAGE_BUCKET=ozon-sjsq-gallery
STORAGE_PUBLIC_BASE_URL=https://img.example.com

# Upload limits.
MAX_UPLOAD_MB=15
MAX_PSD_UPLOAD_MB=600

# Low-server-cost capacity controls.
LEGACY_UPLOAD_ENABLED=true
LEGACY_UPLOAD_MAX_FILES=20
LEGACY_UPLOAD_MAX_BYTES_MB=48
CLOUD_MOCKUP_RENDER_ENABLED=false
CLOUD_MOCKUP_REQUEST_CONCURRENCY=1
TITLE_GENERATION_GLOBAL_CONCURRENCY=20
TITLE_GENERATION_USER_CONCURRENCY=5
