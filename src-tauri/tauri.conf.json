{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ozon SJSQ",
  "version": "0.3.14",
  "identifier": "com.codex.ozon-sjsq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ozon SJSQ",
        "width": 620,
        "height": 430,
        "minWidth": 520,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ozon-sjsq"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwRUQ4N0IwNERBMzlCRUUKUldUdW02Tk5zSWZ0SUd0cTM5NHZ3ZFJXMi9kRWFiblNNYmhNQkhiMmsxdHgwMWpIdXQyS1VxK0YK",
      "endpoints": [
        "https://ghfjscfw.oss-cn-hangzhou.aliyuncs.com/releases/windows/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "Business",
    "resources": {
      "../server/src/mockup-templates/": "mockup-templates/"
    }
  }
}
