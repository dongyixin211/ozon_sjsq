{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ozon SJSQ",
  "version": "0.1.0",
  "identifier": "com.codex.ozon-sjsq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ozon SJSQ",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi"],
    "category": "Business"
  }
}
